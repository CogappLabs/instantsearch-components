{
  "name": "@cogapplabs/instantsearch-components",
  "version": "0.5.1",
  "description": "Reusable React InstantSearch components from Cogapp",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "test:e2e": "playwright test"
  },
  "author": "Cogapp",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "instantsearch.js": "^4.118.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-instantsearch": "^7.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-instantsearch": ">=7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date-histogram": {
      "types": "./dist/date-histogram/index.d.ts",
      "import": "./dist/date-histogram/index.js"
    },
    "./date-histogram.css": {
      "types": "./dist/date-histogram/date-histogram.css.d.ts",
      "default": "./dist/date-histogram/date-histogram.css"
    },
    "./package.json": "./package.json",
    "./facet-toggle": {
      "types": "./dist/facet-toggle/index.d.ts",
      "import": "./dist/facet-toggle/index.js"
    },
    "./facet-toggle.css": {
      "types": "./dist/facet-toggle/facet-toggle.css.d.ts",
      "default": "./dist/facet-toggle/facet-toggle.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CogappLabs/instantsearch-components.git"
  },
  "homepage": "https://cogapplabs.github.io/instantsearch-components/"
}
