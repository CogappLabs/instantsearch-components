{
  "name": "@cogapplabs/instantsearch-components",
  "version": "0.1.0",
  "description": "Reusable React InstantSearch components from Cogapp",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/date-histogram/date-histogram.css dist/date-histogram/",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check ."
  },
  "author": "Cogapp",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/react": "^19.3.0",
    "lefthook": "^2.1.14",
    "react": "^19.3.0",
    "react-instantsearch": "^7.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-instantsearch": ">=7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date-histogram.css": "./dist/date-histogram/date-histogram.css",
    "./date-histogram": {
      "types": "./dist/date-histogram/index.d.ts",
      "import": "./dist/date-histogram/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CogappLabs/instantsearch-components.git"
  },
  "homepage": "https://cogapplabs.github.io/instantsearch-components/"
}
